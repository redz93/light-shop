{
  "name": "maison",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @maison/web dev",
    "dev:api": "pnpm --filter @maison/api dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @maison/database generate",
    "db:migrate": "pnpm --filter @maison/database migrate:dev",
    "db:deploy": "pnpm --filter @maison/database migrate:deploy",
    "db:seed": "pnpm --filter @maison/database seed",
    "db:studio": "pnpm --filter @maison/database studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
