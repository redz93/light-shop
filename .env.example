# ============ GÉNÉRAL ============
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ============ BASE DE DONNÉES ============
# Local (docker compose up -d) :
DATABASE_URL=postgresql://maison:maison_dev_password@localhost:5432/maison?schema=public

# ============ AUTH ============
# Générer : openssl rand -base64 48   (deux valeurs DIFFÉRENTES)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=localhost

# ============ STRIPE (clés externes requises) ============
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============ EMAIL (Resend — clé externe requise) ============
RESEND_API_KEY=
EMAIL_FROM="Maison <no-reply@example.com>"

# ============ DROPSHIPPING (CJdropshipping — clé externe requise) ============
# SUPPLIER_MODE=simulation : aucun appel réel, réponses simulées.
SUPPLIER_MODE=simulation
CJ_API_KEY=
CJ_API_SECRET=

# ============ IMAGES (Cloudinary — clé externe requise) ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ ANTI-SPAM (optionnel) ============
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============ BOUTIQUE ============
STORE_NAME=Maison
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=EUR
ADMIN_ALERT_EMAIL=

# ============ SEED (dev uniquement) ============
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ============ FRONTEND (variables publiques UNIQUEMENT) ============
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ALLOW_INDEXING=false

# Active le bouton « Passer la commande » (à passer à true en Phase 6/7)
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# ============ API (Phase 4) ============
LOG_LEVEL=info
# Origines CORS supplémentaires (séparées par des virgules). FRONTEND_URL est déjà autorisée.
# CORS_ORIGINS=https://preview.example.com
